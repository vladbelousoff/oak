let greeting = 'hello';
print(greeting);

let name = 'world';
print(name);

let message = greeting + ' ' + name;
print(message);

let line = '---';
let border = line + line + line;
print(border);

let escaped = 'line1\nline2';
print(escaped);

let subsNum = [2, 3, 5];
print('{0}+{1}={2}'.format(subsNum));

let subsStr = ['a', 'b'];
print('{}{}'.format(subsStr));

let emptyNum = [] as number[];
print('{{brace}}'.format(emptyNum));

print(greeting.size());
print(''.size());
print('abc'.size());
