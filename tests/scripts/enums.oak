enum Color { Red, Green, Blue }
enum Direction { North, East, South, West }

let r = Color.Red;
let g = Color.Green;
let b = Color.Blue;
print(r);
print(g);
print(b);

let n = Direction.North;
let w = Direction.West;
print(n);
print(w);

fn is_red(c : Color) -> bool {
  return c == Color.Red;
}
print(is_red(r));
print(is_red(g));
