record Point {
  x : number;
  y : number;
}

fn make_point(x : number, y : number) -> Point {
  return new Point { x: x, y: y };
}

fn scale(p : Point, factor : number) -> Point {
  return new Point { x: p.x * factor, y: p.y * factor };
}

fn sum_coords(p : Point) -> number {
  return p.x + p.y;
}
