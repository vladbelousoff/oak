fn identity<T>(x: T) -> T {
  return x;
}

print(identity(42));
print(identity('hello'));
print(identity(true));

fn pick_first<A, B>(a: A, b: B) -> A {
  return a;
}

fn pick_second<A, B>(a: A, b: B) -> B {
  return b;
}

print(pick_first(1, 'two'));
print(pick_second(1, 'two'));

fn first<T>(arr: T[]) -> T {
  return arr[0];
}

print(first([10, 20, 30]));
print(first(['a', 'b', 'c']));

record Box<T> {
  value: T;
}

fn Box.get(self) -> T {
  return self.value;
}

let num_box = new Box { value: 99 };
let str_box = new Box { value: 'oak' };
print(num_box.get());
print(str_box.get());

record Pair<A, B> {
  first: A;
  second: B;
}

let p = new Pair { first: 42, second: 'answer' };
print(p.first);
print(p.second);

fn unwrap<T>(b: Box<T>) -> T {
  return b.value;
}

print(unwrap(num_box));
print(unwrap(str_box));

record Container<T> {
  items: T[];
}

let c = new Container { items: [3, 1, 4, 1, 5] };
print(c.items[0]);
print(c.items[2]);
