enum Status { Planned, Active, Done }

record Point {
  x : number;
  y : number;
}

fn Point.sum(self) -> number {
  return self.x + self.y;
}

fn Point.moveBy(mut self, dx : number, dy : number) {
  self.x = self.x + dx;
  self.y = self.y + dy;
}

fn Point.distSq(self, other : Point) -> number {
  let dx = self.x - other.x;
  let dy = self.y - other.y;
  return dx * dx + dy * dy;
}

record Job {
  title : string;
  status : Status;
  location : Point;
}

fn Job.label(self) -> string {
  return self.title;
}

fn statusName(status : Status) -> string {
  if status == Status.Planned {
    return 'planned';
  }
  if status == Status.Active {
    return 'active';
  }
  return 'done';
}

let origin = new Point { x : 0, y : 0 };
let mut p = new Point { x : 3, y : 4 };
print(p.sum());
print(p.distSq(origin));

p.moveBy(10, -2);
print(p.x);
print(p.y);

let job = new Job {
  title : 'release',
  status : Status.Planned,
  location : p
};

print(job.label());
print(statusName(job.status));
let done = new Job {
  title : 'archive',
  status : Status.Done,
  location : origin
};
print(statusName(done.status));
print(job.location.x);
