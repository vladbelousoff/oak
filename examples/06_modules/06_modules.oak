import { sum, average } from analytics.stats;
import * from domain.project;
import domain.project as project;

let values = [3, 5, 8, 13];
print(sum(values));
print(average(values));

let high = project.Priority.High;
let mut task = project.make_task('ship examples', 8, high);
print(task.title);
print(task.points);
print(task.done);

project.finish(task);
print(task.done);
print(project.summary(task));
print(task.describe());
