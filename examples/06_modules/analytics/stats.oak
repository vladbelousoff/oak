export fn sum(values : number[]) -> number {
  let mut total = 0;
  for value in values {
    total += value;
  }
  return total;
}

export fn average(values : number[]) -> number {
  if values.size() == 0 {
    return 0;
  }
  return sum(values) / values.size();
}

export interface IMetric {
  fn value() -> number;
}

export record Series implements IMetric {
  samples : number[];

  export fn value() -> number {
    return average(self.samples);
  }
}
