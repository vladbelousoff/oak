export enum Priority { Low, Normal, High }

export record Task {
  title : string;
  points : number;
  priority : Priority;
  done : bool;

  export fn describe() -> string {
    if self.done {
      return self.title + ' [done]';
    }
    return self.title + ' [open]';
  }

  export fn mut mark_done() {
    self.done = true;
  }

  /* Not exported: reachable from inside this module only. */
  fn internal_helper() -> string {
    return 'internal';
  }
}

export fn make_task(title : string, points : number, priority : Priority) -> Task {
  return new Task {
    title : title,
    points : points,
    priority : priority,
    done : false
  };
}

export fn priority_name(priority : Priority) -> string {
  if priority == Priority.Low {
    return 'low';
  }
  if priority == Priority.Normal {
    return 'normal';
  }
  return 'high';
}

export fn finish(mut task : Task) {
  task.done = true;
}

export fn summary(task : Task) -> string {
  if task.done {
    return task.title + ' done';
  }
  return task.title + ' open';
}
