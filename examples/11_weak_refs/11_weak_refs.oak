record Node {
  name : string;
  links : Edge[];
}

record Edge {
  label : string;
  target : Node weak;
}

record Graph {
  name : string;
  nodes : Node[];
  entry : Node weak;
}

fn printLinks(node : Node weak) {
  print(node.name);
  for edge in node.links {
    print(edge.label);
    print(edge.target.name);
  }
}

let mut lexer = new Node {
  name : 'lexer',
  links : [] as Edge[]
};
let mut parser = new Node {
  name : 'parser',
  links : [] as Edge[]
};
let mut compiler = new Node {
  name : 'compiler',
  links : [] as Edge[]
};
let mut vm = new Node {
  name : 'vm',
  links : [] as Edge[]
};

lexer.links.push(new Edge {
  label : 'tokens',
  target : parser
});
parser.links.push(new Edge {
  label : 'ast',
  target : compiler
});
compiler.links.push(new Edge {
  label : 'bytecode',
  target : vm
});
vm.links.push(new Edge {
  label : 'debug trace',
  target : compiler
});

let pipeline = new Graph {
  name : 'oak pipeline',
  nodes : [lexer, parser, compiler, vm],
  entry : lexer
};

print(pipeline.name);
print(pipeline.nodes.size());
printLinks(pipeline.entry);
printLinks(vm);
