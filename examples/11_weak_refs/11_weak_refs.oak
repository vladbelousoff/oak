record Node {
  name : string;
  links : Edge[];
}

record Edge {
  label : string;
  target : Node weak;
}

record Graph {
  name : string;
  nodes : Node[];
  entry : Node weak;
}

fn print_links(node : Node weak) {
  print(node.name);
  for edge in node.links {
    print(edge.label);
    print(edge.target.name);
  }
}

let mut lexer = new Node {
  name : 'lexer',
  links : [] as Edge[]
};
let mut parser = new Node {
  name : 'parser',
  links : [] as Edge[]
};
let mut compiler = new Node {
  name : 'compiler',
  links : [] as Edge[]
};
let mut vm = new Node {
  name : 'vm',
  links : [] as Edge[]
};

lexer.links.push(new Edge {
  label : 'tokens',
  target : parser
});
parser.links.push(new Edge {
  label : 'ast',
  target : compiler
});
compiler.links.push(new Edge {
  label : 'bytecode',
  target : vm
});
vm.links.push(new Edge {
  label : 'debug trace',
  target : compiler
});

let mut pipeline = new Graph {
  name : 'oak pipeline',
  nodes : [lexer, parser, compiler, vm],
  entry : lexer
};

print(pipeline.name);
print(pipeline.nodes.size());
print_links(pipeline.entry);
print_links(vm);

let empty_graph = new Graph {
  name : 'empty',
  nodes : [] as Node[],
  entry : none
};
print(empty_graph.entry == none);
print(empty_graph.entry != none);

pipeline.entry = none;
print(pipeline.entry == none);
