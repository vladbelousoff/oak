fn isPrime(n : number) -> bool {
  if n < 2 {
    return false;
  }

  let mut divisor = 2;
  while divisor < n {
    if n % divisor == 0 {
      return false;
    }
    divisor += 1;
  }

  return true;
}

fn collectPrimes(limit : number) -> number[] {
  let mut primes = [] as number[];
  for n from 2 to limit {
    if isPrime(n) {
      primes.push(n);
    }
  }
  return primes;
}

fn insertionSort(mut values : number[]) {
  let mut i = 1;
  while i < values.size() {
    let key = values[i];
    let mut j = i;
    while j > 0 and values[j - 1] > key {
      values[j] = values[j - 1];
      j -= 1;
    }
    values[j] = key;
    i += 1;
  }
}

let primes = collectPrimes(30);
for prime in primes {
  print(prime);
}
print(primes.size());

let mut mixed = [9, 1, 5, 3, 8, 2];
insertionSort(mixed);
for value in mixed {
  print(value);
}
