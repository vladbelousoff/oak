interface IShape {
  fn area() -> number;
  fn describe() -> string;
}

record Circle implements IShape {
  radius : number;

  fn area() -> number {
    return 3.14159 * self.radius * self.radius;
  }

  fn describe() -> string {
    return 'circle';
  }
}

record Rect implements IShape {
  w : number;
  h : number;

  fn area() -> number {
    return self.w * self.h;
  }

  fn describe() -> string {
    return 'rect';
  }
}

fn print_shape(s: IShape) {
  print(s.describe());
  print(s.area());
}

let mut c = new Circle { radius: 5 };
let mut r = new Rect { w: 3, h: 4 };

print_shape(c);
print_shape(r);

let mut shapes = new IShape[];
shapes.push(c);
shapes.push(r);

let mut total = 0;
for s in shapes {
  total += s.area();
}
print(total);
