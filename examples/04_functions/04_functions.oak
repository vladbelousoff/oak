fn add(a : number, b : number) -> number {
  return a + b;
}

fn factorial(n : number) -> number {
  if n <= 1 {
    return 1;
  }
  return n * factorial(n - 1);
}

fn even(n : number) -> bool {
  if n == 0 {
    return true;
  }
  return odd(n - 1);
}

fn odd(n : number) -> bool {
  if n == 0 {
    return false;
  }
  return even(n - 1);
}

fn sum(values : number[]) -> number {
  let total = 0;
  for value in values {
    total += value;
  }
  return total;
}

print(add(20, 22));
print(factorial(5));
print(even(10));
print(odd(10));
print(sum([3, 5, 8, 13]));
