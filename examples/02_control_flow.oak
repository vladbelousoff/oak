print('02 control flow');

for i from 1 to 16 {
  if i % 15 == 0 {
    print('fizzbuzz');
  } else {
    if i % 3 == 0 {
      print('fizz');
    } else {
      if i % 5 == 0 {
        print('buzz');
      } else {
        print(i);
      }
    }
  }
}

let mut n = 13;
let mut steps = 0;
while n != 1 {
  if n % 2 == 0 {
    n /= 2;
  } else {
    n = n * 3 + 1;
  }
  steps += 1;
}
print(steps);

for i from 1 to 20 {
  if i % 2 == 0 {
    continue;
  }
  if i > 9 {
    break;
  }
  print(i);
}
