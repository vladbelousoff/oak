let double = fn(x: number) -> number {
  return x * 2;
};

print(double(5));
print(double(21));

fn apply(f: fn(number) -> number, x: number) -> number {
  return f(x);
}

let inc = fn(x: number) -> number { return x + 1; };
print(apply(inc, 99));
print(apply(double, 7));

fn add(a: number, b: number) -> number {
  return a + b;
}

let f = add;
print(f(10, 20));

fn compose(f: fn(number) -> number, g: fn(number) -> number, x: number) -> number {
  return f(g(x));
}

let square = fn(x: number) -> number { return x * x; };
print(compose(double, inc, 4));
print(compose(inc, square, 5));
