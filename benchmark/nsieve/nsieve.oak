fn nsieve(limit : number) -> number {
  let mut flags = new number[];
  for i from 0 to limit + 1 {
    flags.push(1);
  }

  let mut p = 2;
  while p * p <= limit {
    if flags[p] == 1 {
      let mut m = p * p;
      while m <= limit {
        flags[m] = 0;
        m += p;
      }
    }
    p += 1;
  }

  let mut count = 0;
  for n from 2 to limit + 1 {
    if flags[n] == 1 {
      count += 1;
    }
  }
  return count;
}

let mut total = 0;
for rep from 0 to 1 {
  total += nsieve(500000);
}
print(total);
