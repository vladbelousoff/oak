<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">

    <Type Name="_oak_token_t">
        <DisplayString Condition="kind == OAK_TOKEN_INT_NUM">{kind} {*(int*)buf}</DisplayString>
        <DisplayString Condition="kind == OAK_TOKEN_FLOAT_NUM">{kind} {*(float*)buf}</DisplayString>
        <DisplayString Condition="size > 0">{kind} {(char*)buf,s8}</DisplayString>
        <DisplayString>{kind}</DisplayString>
        <Expand HideRawView="true">
            <Item Name="kind">kind</Item>
            <Item Name="value" Condition="kind == OAK_TOKEN_INT_NUM">*(int*)buf</Item>
            <Item Name="value" Condition="kind == OAK_TOKEN_FLOAT_NUM">*(float*)buf</Item>
            <Item Name="value"
                  Condition="size > 0 &amp;&amp; kind != OAK_TOKEN_INT_NUM &amp;&amp; kind != OAK_TOKEN_FLOAT_NUM">
                (char*)buf,s8
            </Item>
            <Item Name="line">line</Item>
            <Item Name="column">column</Item>
            <Item Name="pos">pos</Item>
            <Item Name="size">size</Item>
        </Expand>
    </Type>

    <Type Name="oak_lexer_result_t">
        <DisplayString>tokens</DisplayString>
        <Expand HideRawView="true">
            <CustomListItems>
                <Variable Name="entry" InitialValue="tokens.next"/>
                <Loop>
                    <If Condition="entry == &amp;tokens">
                        <Break/>
                    </If>
                    <Item>*(_oak_token_t*)entry</Item>
                    <Exec>entry = entry->next</Exec>
                </Loop>
            </CustomListItems>
        </Expand>
    </Type>

    <Type Name="oak_value_t">
        <DisplayString Condition="(bits &amp; 7) == 0">i32 {*(int*)((char*)&amp;bits + 4)}</DisplayString>
        <DisplayString Condition="(bits &amp; 7) == 1">f32 {*(float*)((char*)&amp;bits + 4)}</DisplayString>
        <DisplayString Condition="(bits &amp; 7) == 2">bool {(bits >> 32) != 0}</DisplayString>
        <DisplayString Condition="(bits &amp; 7) == 3">none</DisplayString>
        <DisplayString Condition="(bits &amp; 7) == 4">handle {bits >> 3}</DisplayString>
        <DisplayString Condition="(bits &amp; 7) == 5">obj table={(unsigned int)((bits >> 32) &amp; 0xFF)} slot={(unsigned int)((bits >> 3) &amp; 0x1FFFFFFF)} nonce={(unsigned int)(bits >> 40)}</DisplayString>
        <DisplayString Condition="(bits &amp; 7) == 6">weak table={(unsigned int)((bits >> 32) &amp; 0xFF)} slot={(unsigned int)((bits >> 3) &amp; 0x1FFFFFFF)} nonce={(unsigned int)(bits >> 40)}</DisplayString>
        <DisplayString Condition="(bits &amp; 7) == 7">native {(void*)(bits >> 3)}</DisplayString>
        <Expand>
            <Item Name="tag">(oak_value_tag_t)(bits &amp; 7)</Item>
            <Item Name="obj" Condition="(bits &amp; 7) == 5 || (bits &amp; 7) == 6">
                oak_obj_tables[(unsigned int)((bits >> 32) &amp; 0xFF)].slots[(unsigned int)((bits >> 3) &amp; 0x1FFFFFFF)].obj
            </Item>
            <Item Name="live" Condition="(bits &amp; 7) == 6">
                (unsigned int)((bits >> 3) &amp; 0x1FFFFFFF) &lt; oak_obj_tables[(unsigned int)((bits >> 32) &amp; 0xFF)].capacity &amp;&amp; oak_obj_tables[(unsigned int)((bits >> 32) &amp; 0xFF)].slots[(unsigned int)((bits >> 3) &amp; 0x1FFFFFFF)].nonce == (unsigned int)(bits >> 40)
            </Item>
        </Expand>
    </Type>

    <Type Name="_oak_ast_node_t">
        <Intrinsic Name="op_token" Expression="oak_grammar[kind].op == OAK_GRAMMAR_TOKEN">
            <Parameter Name="kind" Type="oak_node_kind_t"/>
        </Intrinsic>
        <Intrinsic Name="op_unary" Expression="oak_grammar[kind].op == OAK_GRAMMAR_UNARY">
            <Parameter Name="kind" Type="oak_node_kind_t"/>
        </Intrinsic>
        <Intrinsic Name="op_binary" Expression="oak_grammar[kind].op == OAK_GRAMMAR_BINARY">
            <Parameter Name="kind" Type="oak_node_kind_t"/>
        </Intrinsic>
        <Intrinsic Name="op_list"
                   Expression="oak_grammar[kind].op != OAK_GRAMMAR_TOKEN &amp;&amp; oak_grammar[kind].op != OAK_GRAMMAR_UNARY &amp;&amp; oak_grammar[kind].op != OAK_GRAMMAR_BINARY">
            <Parameter Name="kind" Type="oak_node_kind_t"/>
        </Intrinsic>
        <DisplayString Condition="op_token(kind)">{kind} ({token->kind})</DisplayString>
        <DisplayString>{kind}</DisplayString>
        <Expand HideRawView="true">
            <Item Name="rule">kind</Item>
            <Item Name="token" Condition="op_token(kind)">token</Item>
            <Item Name="child" Condition="op_unary(kind)">*child</Item>
            <Item Name="lhs" Condition="op_binary(kind)">*lhs</Item>
            <Item Name="rhs" Condition="op_binary(kind)">*rhs</Item>
            <CustomListItems Condition="op_list(kind)">
                <Variable Name="entry" InitialValue="children.next"/>
                <Loop>
                    <If Condition="entry == &amp;children">
                        <Break/>
                    </If>
                    <Item>*(_oak_ast_node_t*)entry</Item>
                    <Exec>entry = entry->next</Exec>
                </Loop>
            </CustomListItems>
        </Expand>
    </Type>

</AutoVisualizer>
