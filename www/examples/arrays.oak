let mut nums = [] as number[];
nums.push(10);
nums.push(20);
nums.push(30);
nums.push(40);

print(nums.size());

nums[0] = 99;
print(nums[0]);
print(nums[nums.size() - 1]);

let mut total = 0;
for v in nums {
  total += v;
}
print(total);

for i, v in nums {
  print(i);
  print(v);
}

let words = ['oak', 'is', 'fun'];
for w in words {
  print(w);
}
